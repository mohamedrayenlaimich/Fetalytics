# ==============================================================================
# Fetalytics Environment Configuration Template (.env.example)
# Copy this file to .env and fill in real credentials. Never commit .env to Git.
# ==============================================================================

# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@ep-sample-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Backblaze B2 S3-Compatible Object Storage
B2_KEY_ID=your_b2_key_id_here
B2_KEY_NAME=fetalytics-backend
B2_APPLICATION_KEY=your_b2_application_key_here
B2_ENDPOINT_URL=s3.us-east-005.backblazeb2.com
B2_BUCKET_NAME=fetalytics-storage
B2_REGION_NAME=us-east-005
B2_PRESIGNED_URL_EXPIRY_SECONDS=900

# API Security & Rate Limiting
API_KEY_SECRET=change_me_in_production_api_key
JWT_SECRET_KEY=change_me_in_production_jwt_secret
MAX_UPLOAD_SIZE_MB=500
RATE_LIMIT_PER_MINUTE=60

# Storage & Retention Settings
TEMP_STORAGE_DIR=./tmp_ingest
RETENTION_DAYS_UPLOADS=30
RETENTION_DAYS_ARTIFACTS=90
